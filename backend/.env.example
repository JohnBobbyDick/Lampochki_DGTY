# Copy to backend/.env (never commit .env). Lists are comma-separated; put values containing '#' in quotes.
LLM_ENABLED=true
LLM_PROVIDER=gemini                       # gemini | ollama

# --- Gemini keys: a list; each retry uses a different key ---
GEMINI_API_KEY=key1,key2,key3
GEMINI_KEYS_COUNT=3                       # optional: use only the first N keys of the list
GEMINI_MODEL=gemini-2.5-flash             # attempt 1; later attempts fall back to lighter models
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_MAX_RETRIES=5                     # optional; default = number of keys (max 5)

# --- Proxies for Gemini requests: ip:login:password or ip:port:login:password, comma-separated ---
GEMINI_PROXIES=1.2.3.4:8080:user:pass,5.6.7.8:8080:user2:pass2
GEMINI_PROXY_SCHEME=auto                  # auto = сам определяет и перебирает http/socks5/https; либо http|https|socks5|socks5h
GEMINI_PROXY_PORT=                        # used only for entries written as ip:login:password

# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=codellama:7b
